<% is_premium = premium_features.include?(feature_key) %>
<% icon = SuperAdmin::AccountFeaturesHelper.feature_icon(feature_key) %>
<%# This bitset flag is a Super Admin override, independent of IntelychatHub's
    installation-level community/enterprise license — actual premium access is
    now enforced per-account via Featurable#feature_enabled? against the
    account's Plan/AccountSubscription, so Super Admin can always toggle it. %>
<% should_disable = false %>
<% checkbox_id = "enabled_features_feature_#{feature_key}" if editable %>

<% if editable %>
  <label
    for="<%= checkbox_id %>"
    class="feature-card <%= 'is-checked' if enabled %> <%= 'is-disabled' if should_disable %>"
    data-feature-item
    data-feature-name="<%= display_name %>"
    data-feature-category="<%= category %>"
    <% if channel_type.present? %>data-channel-type="<%= channel_type %>"<% end %>
  >
    <div class="flex items-center gap-3 min-w-0">
      <span class="flex items-center justify-center w-9 h-9 shrink-0 rounded-lg bg-n-alpha-2 text-n-slate-11">
        <svg width="16" height="16"><use xlink:href="#<%= icon %>" /></svg>
      </span>
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="text-sm font-medium text-n-slate-12 truncate"><%= display_name %></span>
          <% if is_premium %>
            <span class="shrink-0 inline-flex items-center px-1.5 h-5 rounded-md bg-n-solid-amber text-n-amber-text text-xxs font-medium">
              Premium
            </span>
          <% end %>
        </div>
        <% if channel_label.present? %>
          <span class="text-xxs text-n-slate-10"><%= channel_label %></span>
        <% end %>
      </div>
    </div>

    <span class="shrink-0">
      <%= check_box "enabled_features", "feature_#{feature_key}", {
            checked: enabled,
            disabled: should_disable,
            id: checkbox_id,
            class: "h-4 w-4 rounded border-n-weak text-n-brand focus:ring-n-brand",
            onchange: "syncFeatureCardState(this)"
          }, true, false %>
    </span>
  </label>
<% else %>
  <div
    class="feature-card <%= 'is-checked' if enabled.present? %>"
    data-feature-item
    data-feature-name="<%= display_name %>"
    data-feature-category="<%= category %>"
    <% if channel_type.present? %>data-channel-type="<%= channel_type %>"<% end %>
  >
    <div class="flex items-center gap-3 min-w-0">
      <span class="flex items-center justify-center w-9 h-9 shrink-0 rounded-lg bg-n-alpha-2 text-n-slate-11">
        <svg width="16" height="16"><use xlink:href="#<%= icon %>" /></svg>
      </span>
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="text-sm font-medium text-n-slate-12 truncate"><%= display_name %></span>
          <% if is_premium %>
            <span class="shrink-0 inline-flex items-center px-1.5 h-5 rounded-md bg-n-solid-amber text-n-amber-text text-xxs font-medium">
              Premium
            </span>
          <% end %>
        </div>
        <% if channel_label.present? %>
          <span class="text-xxs text-n-slate-10"><%= channel_label %></span>
        <% end %>
      </div>
    </div>

    <span class="<%= enabled.present? ? 'bg-n-teal-9 text-white' : 'bg-n-alpha-2 text-n-slate-9' %> rounded-full p-1 inline-flex shrink-0">
      <svg width="12" height="12"><use xlink:href="#icon-tick-line" /></svg>
    </span>
  </div>
<% end %>
